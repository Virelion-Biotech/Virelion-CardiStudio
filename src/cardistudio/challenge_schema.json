{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelion-biotech.github.io/schemas/cardistudio.challenge.v1.json",
  "title": "CardiStudio Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "domain", "population", "features"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "enum": ["1.0", "1.1"]},
    "domain": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "groups", "group_field", "biological_replicates", "seed"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "group_field": {"type": "string", "minLength": 1},
        "biological_replicates": {"type": "integer", "minimum": 1},
        "sections_per_subject": {"type": "integer", "minimum": 1},
        "intraclass_correlation": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "subject_field": {"type": "string", "minLength": 1},
        "section_field": {"type": "string", "minLength": 1},
        "observation_field": {"type": "string", "minLength": 1},
        "copula_features": {"type": "array", "items": {"type": "string"}},
        "correlation": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"type": "array", "items": {"type": "number"}}
            }
          ]
        },
        "seed": {"type": "integer"}
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dtype", "distribution", "params", "unit", "description", "min_value", "max_value"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dtype": {"type": "string", "enum": ["continuous", "integer", "binary", "categorical"]},
          "distribution": {"type": "string", "enum": ["normal", "uniform", "lognormal", "bernoulli", "categorical", "constant"]},
          "params": {"type": "object"},
          "unit": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "min_value": {"type": ["number", "null"]},
          "max_value": {"type": ["number", "null"]},
          "effects": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shift": {"type": "number"},
                "scale": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    },
    "metadata": {"type": "object"},
    "interventions": {"type": "array", "items": {"type": "object"}},
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "expr", "severity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"const": "relation"},
          "expr": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["error", "warning"]}
        }
      }
    }
  }
}
